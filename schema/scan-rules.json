{
  "description": "Shared scan rules. Frontend (TypeScript) and backend (Python) keep copies of them; tests in both languages check that the copies match this file.",
  "skipDirectories": ["node_modules", ".git", "venv", ".venv", "dist", "build", ".next", "__pycache__"],
  "skipFiles": {
    "exact": [".env", "package-lock.json", "npm-shrinkwrap.json", "pnpm-lock.yaml", "bun.lockb"],
    "prefixes": [".env."],
    "suffixes": [".env", ".lock"]
  },
  "envTemplates": [".env.example", ".env.sample", ".env.template", ".env.dist"],
  "binaryExtensions": [
    ".png", ".jpg", ".jpeg", ".gif", ".bmp", ".ico", ".webp", ".tif", ".tiff", ".avif", ".heic", ".psd",
    ".mp4", ".mov", ".avi", ".mkv", ".webm", ".mp3", ".wav", ".ogg", ".flac", ".aac",
    ".zip", ".tar", ".gz", ".tgz", ".bz2", ".xz", ".7z", ".rar", ".jar", ".war",
    ".pdf", ".exe", ".dll", ".so", ".dylib", ".bin", ".class", ".o", ".a", ".pyc", ".wasm",
    ".woff", ".woff2", ".ttf", ".otf", ".eot", ".sqlite", ".db", ".iso", ".dmg"
  ],
  "limits": {
    "maxFileBytes": 1048576,
    "maxFiles": 600,
    "maxDepth": 50
  },
  "whitespace": " \t\n\r\f\u000b"
}
